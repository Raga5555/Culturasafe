{
  "openapi": "3.0.3",
  "info": {
    "title": "CulturaSafe Backend API",
    "description": "Smart Tourism, Belongings Safety & GPS Location Tracking REST API for CulturaSafe",
    "version": "1.0.0",
    "contact": {
      "name": "CulturaSafe Engineering Support",
      "email": "support@culturasafe.example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    },
    {
      "url": "https://culturasafe-backend.onrender.com",
      "description": "Production / Staging Server (Render)"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your Supabase session access_token"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "object" },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "tourist@example.com" },
          "password": { "type": "string", "minLength": 6, "example": "secretPass123!" },
          "displayName": { "type": "string", "example": "Puducherry Explorer" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "tourist@example.com" },
          "password": { "type": "string", "example": "secretPass123!" }
        }
      },
      "ItineraryRequest": {
        "type": "object",
        "required": ["destination", "travelDate"],
        "properties": {
          "destination": { "type": "string", "example": "Puducherry" },
          "travelDate": { "type": "string", "example": "2026-10-15" },
          "startTime": { "type": "string", "example": "09:00" },
          "endTime": { "type": "string", "example": "17:00" },
          "interests": { "type": "array", "items": { "type": "string" }, "example": ["heritage", "beaches", "cafes"] },
          "itineraryData": { "type": "object" },
          "status": { "type": "string", "enum": ["planned", "in_progress", "completed", "cancelled"] }
        }
      },
      "BelongingRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "example": "Travel Backpack" },
          "itemType": { "type": "string", "enum": ["backpack", "wallet", "camera", "luggage", "passport", "keys", "other"] },
          "tagMacAddress": { "type": "string", "example": "AA:BB:CC:DD:EE:FF" },
          "tagUuid": { "type": "string", "example": "0000ffe0-0000-1000-8000-00805f9b34fb" },
          "batteryLevel": { "type": "integer", "minimum": 0, "maximum": 100, "example": 88 },
          "alertOnSeparation": { "type": "boolean", "example": true }
        }
      },
      "LocationPointRequest": {
        "type": "object",
        "required": ["latitude", "longitude", "consentGiven"],
        "properties": {
          "latitude": { "type": "number", "example": 11.9338 },
          "longitude": { "type": "number", "example": 79.8347 },
          "accuracyMeters": { "type": "number", "example": 8.5 },
          "consentGiven": { "type": "boolean", "example": true }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "System Health Check",
        "description": "Verifies server and Supabase PostgreSQL connectivity latency.",
        "responses": {
          "200": { "description": "System operational" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register New Tourist Account",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } }
        },
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Validation or email error" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "User Login",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Get Current User Profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Current user identity and profile" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/destinations/saved": {
      "get": {
        "summary": "List Saved Favourite Places",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of saved destinations" } }
      },
      "post": {
        "summary": "Save Place to Favourites",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["destinationId", "destinationName"],
                "properties": {
                  "destinationId": { "type": "string", "example": "ashram" },
                  "destinationName": { "type": "string", "example": "Sri Aurobindo Ashram" },
                  "placeType": { "type": "string", "example": "Spiritual" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Destination saved" } }
      }
    },
    "/api/v1/destinations/saved/{destinationId}": {
      "delete": {
        "summary": "Remove Place from Favourites",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "destinationId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Removed" } }
      }
    },
    "/api/v1/itineraries": {
      "get": {
        "summary": "List User Itineraries",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Array of itineraries" } }
      },
      "post": {
        "summary": "Create Itinerary Plan",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ItineraryRequest" } } }
        },
        "responses": { "201": { "description": "Itinerary created" } }
      }
    },
    "/api/v1/itineraries/{id}": {
      "get": {
        "summary": "Get Itinerary Details",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Itinerary object" }, "404": { "description": "Not found" } }
      },
      "put": {
        "summary": "Update Itinerary",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ItineraryRequest" } } } },
        "responses": { "200": { "description": "Updated" } }
      },
      "delete": {
        "summary": "Delete Itinerary",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/v1/location/points": {
      "post": {
        "summary": "Submit Throttled Location Point",
        "description": "Explicit user consent is mandatory. Writes are throttled to prevent spam.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocationPointRequest" } } }
        },
        "responses": {
          "201": { "description": "Location recorded" },
          "429": { "description": "Throttled (too frequent)" }
        }
      }
    },
    "/api/v1/location/history": {
      "get": {
        "summary": "Retrieve Private Location History",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Location points list" } }
      },
      "delete": {
        "summary": "Clear All User Location History",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "All location records deleted" } }
      }
    },
    "/api/v1/belongings": {
      "get": {
        "summary": "List Tracked Belongings",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of user belongings" } }
      },
      "post": {
        "summary": "Register Belonging Tag",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BelongingRequest" } } }
        },
        "responses": { "201": { "description": "Belonging registered" } }
      }
    },
    "/api/v1/belongings/{id}": {
      "delete": {
        "summary": "Unregister Belonging",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Belonging removed" } }
      }
    },
    "/api/v1/belongings/alerts/events": {
      "post": {
        "summary": "Record Hardware Separation Alert Event",
        "description": "Logs an alert detected by the client hardware (separation, reconnection, low battery).",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["alertType"],
                "properties": {
                  "belongingId": { "type": "string" },
                  "alertType": { "type": "string", "enum": ["separation", "low_battery", "reconnected", "sos"] },
                  "latitude": { "type": "number" },
                  "longitude": { "type": "number" },
                  "locationName": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Alert logged" } }
      }
    },
    "/api/v1/sync": {
      "post": {
        "summary": "Batch Offline Synchronization",
        "description": "Uploads locally cached itineraries, favourites, and alert events with deduplication.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["clientSyncId", "clientTimestamp"],
                "properties": {
                  "clientSyncId": { "type": "string" },
                  "clientTimestamp": { "type": "string" },
                  "savedDestinations": { "type": "array", "items": { "type": "object" } },
                  "itineraries": { "type": "array", "items": { "type": "object" } },
                  "alertEvents": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Sync completed" } }
      }
    }
  }
}
