# CulturaSafe Python Backend Environment Variables
# Copy to .env and configure with your Supabase credentials

ENVIRONMENT=development
PORT=5001
HOST=127.0.0.1

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only service role key (Never expose to clients)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Rate Limiting (milliseconds window and max requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=20
