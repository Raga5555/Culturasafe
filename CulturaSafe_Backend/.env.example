# CulturaSafe Backend Environment Variables

# Node Server Environment
NODE_ENV=development
PORT=5001

# CORS Allowed Origins (Comma-separated for multiple origins)
# For development, allow localhost and AI Studio dev preview URL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://ais-dev-ldt6qkvscxzrc4jx4netwn-434541130093.asia-east1.run.app

# Supabase Credentials
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://ucbizchnrqfsfempyzkx.supabase.co
# SUPABASE_ANON_KEY: Client-facing public key for authentication calls
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY: Required for secure server-side admin tasks and bypassing RLS when validating system operations.
# NEVER expose this key in the frontend client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
